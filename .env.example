# 本機起步範本；複製為根目錄 .env 後填入自己的值，不要覆蓋既有 .env。
# 範本選擇 cloud 問答並關閉 Gmail；程式省略時的預設仍為 local / Gmail 開啟。
# 完整說明：docs/configuration.md。秘密只放實際 .env，不填回此檔。

# Discord 與 Gemini
DISCORD_BOT_TOKEN=
# 使用摘要、對話問答或 cloud 角色問答時必填
GOOGLE_GENAI_API_KEY=
# health server port；app.py 不載入 .env，本機需另外設程序環境，容器由 env_file 注入
PORT=8080

# 資料庫與本機備份
# 本機可用 sqlite；正式部署改 postgres 並填 DATABASE_URL。
# 若容器使用 sqlite，SQLITE_PATH 必須指向持久掛載內的檔案。
DB_TYPE=sqlite
SQLITE_PATH=summaries.db
DATABASE_URL=
LOCAL_BACKUP_SQLITE_PATH=postgres_summaries_backup.db

# 解答之書 / el_psy_kongroo 的 LLM 來源：cloud 或 local
ROLE_MODE=cloud
# local 模式才使用；填 base URL，不含 /v1/chat/completions
LOCAL_LLM_URL=http://127.0.0.1:9453

# 社群預覽：0 關閉、1 開啟；guild 管理者仍可覆蓋全域預設
THREADS_PREVIEW_ENABLED=0
FACEBOOK_PREVIEW_ENABLED=0
INSTAGRAM_PREVIEW_ENABLED=0
# >0 為刪除按鈕的逾時秒數；0 為同一程序內不自動逾時，不保證重啟後有效
SOCIAL_PREVIEW_DELETE_TIMEOUT_SECONDS=0

# 三平台 Cookie 各自選填；空白代表該平台只使用匿名來源
# 填入時使用單行：THREADS_COOKIE='cookie_name=value; another_cookie=value'
# 只填 Request Headers 的 Cookie 值，不含 Cookie:，不要填 Set-Cookie
THREADS_COOKIE=
FACEBOOK_COOKIE=
INSTAGRAM_COOKIE=
# 有設定該平台 Cookie 才會保存；0 關閉快取讀寫，1 啟用
SOCIAL_PREVIEW_COOKIE_AUTO_SAVE=1
# 空白使用專案 secrets/social-preview-cookies；容器需搭配持久掛載
SOCIAL_PREVIEW_COOKIE_STORE_DIR=

# Discord 通知：可選；留空頻道 ID 即略過轉發
DISCORD_NOTIFY_FORWARD_CHANNEL_ID=
DISCORD_NOTIFY_FORWARD_GUILD_ID=

# Gmail：準備好 OAuth 與收件者後才改為 1
GMAIL_NOTIFY_ENABLED=0
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SEND_TO=
# 選填，用於郵件內日期提醒；有需要才填含時區的 ISO 8601 日期
GMAIL_REFRESH_TOKEN_ISSUED_AT=
# 僅本機手動 OAuth 維護工具使用，相對於執行時的工作目錄
GMAIL_CLIENT_SECRET_PATH=client_secret.json

# 世界線機率：0～1；特殊使用者 ID 用逗號分隔，留空表示無名單
WORLDLINE_PROB_DEFAULT=0.01048596
WORLDLINE_PROB_ADMIN=0.1
WORLDLINE_ADMIN_IDS=

# DeepFaker：失敗機率 0～1；多句台詞以 | 分隔
DEEPFAKER_FAILURE_PROB=0.05
DEEPFAKER_FAILURE_NOTICE='抓到你了！炸彈魔！'
